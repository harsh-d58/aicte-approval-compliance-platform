# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.static-demo/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local credentials and private keys
.secrets/
secrets/
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
service-account*.json
service_account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
