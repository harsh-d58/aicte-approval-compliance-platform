# Copy this file to .env in the project root. Do not commit actual credentials.
APP_ENV=development
API_PREFIX=/api/v1
# Database owner/migration credential; never used by FastAPI request handling.
DATABASE_URL=
# Generated by `python -m backend.apply_read_runtime_role --apply` after review.
# FastAPI uses this read-only, RLS-scoped URL; keep it out of Git and the browser.
DATABASE_RUNTIME_URL=

# One Supabase project URL is used by FastAPI and exposed publicly to the browser.
SUPABASE_URL=
# Supabase publishable / anon key is public by design. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_PORTAL_MODE=live
FRONTEND_ORIGIN=

# Reserved for the corresponding PRD services when implemented.
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
