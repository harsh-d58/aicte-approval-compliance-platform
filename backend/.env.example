# Copy to backend/.env for local configuration.
# The FastAPI foundation loads these values. Do not commit real credentials.
APP_ENV=development
API_PREFIX=/api/v1

# Existing PostgreSQL database: supply the actual connection URL locally.
# Readiness and schema diagnostics use read-only connections; no database is created.
DATABASE_URL=

# Supabase project base URL, e.g. https://<project-ref>.supabase.co.
# The API derives issuer and JWKS URLs; no JWT signing secret is needed.
SUPABASE_URL=

# Future Redis/Celery connection. Leave unset until available.
REDIS_URL=

# Approved encrypted object storage; provider configuration remains pending.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=

# Provider credentials must use the approved secret-management mechanism.
