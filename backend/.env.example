# Copy to backend/.env for local configuration.
# These names are reserved for the future FastAPI settings layer.
# No backend service consumes them yet. Do not commit real credentials.
APP_ENV=development
API_PREFIX=/api/v1

# Existing PostgreSQL database: supply the actual connection URL locally.
# No database is created or modified by this environment setup.
DATABASE_URL=

# Configured Keycloak/approved identity provider; no demo auth bypass.
IDENTITY_ISSUER_URL=
IDENTITY_AUDIENCE=

# Future Redis/Celery connection. Leave unset until available.
REDIS_URL=

# Approved encrypted object storage; provider configuration remains pending.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=

# Provider credentials must use the approved secret-management mechanism.
